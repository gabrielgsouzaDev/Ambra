# === Ambra — variáveis de ambiente ===
# Copie para .env e preencha. NUNCA comitar o .env real.
# Segredos (JWT, gateway, e-mail) vivem SÓ no servidor — jamais no cliente/bundle.

# --- Banco (PostgreSQL) ---
# Casa com o docker-compose.yml (usuário/senha/porta locais de dev).
DATABASE_URL="postgresql://ambra:ambra@localhost:5433/ambra?schema=public"

# --- Auth ---
# Segredo do JWT. Gere um valor forte e único (ex.: `openssl rand -base64 48`).
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# Validade do token. MVP: 1 dia, sem refresh.
JWT_EXPIRES_IN="1d"

# --- Feature flags ---
# Recarga PIX (AbacatePay) desligada até a ME estar aberta. Só ligar em produção.
PAGAMENTOS_ATIVOS="false"

# --- Servidor ---
PORT="3001"
# Origem do frontend liberada no CORS (Portal/PDV/Admin).
CORS_ORIGIN="http://localhost:3000"

# --- Seed (bootstrap do primeiro Admin da escola) ---
SEED_SCHOOL_NAME="Escola Piloto"
SEED_ADMIN_EMAIL="admin@escola.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Administrador"

# --- Integrações (construídas no sandbox; usadas a partir de M3) ---
# ABACATEPAY_KEY=""
# RESEND_KEY=""
