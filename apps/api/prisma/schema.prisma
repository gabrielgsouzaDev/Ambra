// Schema Prisma — Ambra
// Cresce MÓDULO A MÓDULO. M0 (Fundação & Auth): School + User.
// As demais 7 tabelas (Student, GuardianStudent, Product, Transaction, ...)
// entram a partir do M1, conforme doc/Identidade/Banco_de_Dados.md.
//
// Princípios (invioláveis): dinheiro sempre Int em centavos (sufixo `Cents`);
// uma escola por instância (schoolId simples, SEM multi-tenant/RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Papéis de quem loga. Aluno NÃO loga (é passivo, só o cartão QR).
enum Role {
  ADMIN
  OPERATOR
  RESPONSAVEL
}

// Ciclo de vida da conta: PENDING até ativar via convite; ACTIVE após criar senha.
enum UserStatus {
  PENDING
  ACTIVE
}

// Estado do cartão do aluno. BLOCKED impede o débito no PDV; reemissão gera novo QR.
enum CardStatus {
  ACTIVE
  BLOCKED
}

// Tipo de lançamento no livro-caixa (append-only). PURCHASE entra no M5 (PDV).
enum TxType {
  RECHARGE
  PURCHASE
}

// Ciclo de vida da recarga PIX (via porta PaymentGateway).
enum RechargeStatus {
  PENDING
  CONFIRMED
  FAILED
}

// A escola. Uma linha por instância (uma escola por instância).
model School {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  users     User[]
  students  Student[]
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Quem loga: Admin (escola), Operador (cantina), Responsável (pai).
model User {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  name         String
  email        String     @unique
  passwordHash String? // nulo até ativar a conta (convite → cria senha)
  role         Role
  status       UserStatus @default(PENDING)

  // Convite/ativação (mesmos campos servem de "esqueci a senha"). Guardar HASH, nunca texto.
  inviteTokenHash String?
  inviteExpiresAt DateTime?

  // Vínculo com alunos (só faz sentido para RESPONSAVEL). N:N via GuardianStudent.
  students  GuardianStudent[]
  recharges Recharge[] // recargas que este responsável iniciou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// O aluno. NÃO loga (passivo) — é identificado pelo cartão QR no balcão.
// M1: só identidade + cartão. Carteira/saldo entram no M3; bloqueio de cartão no M2.
model Student {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  name     String
  turma    String?
  rm       String // matrícula (identificador da escola; usado no fallback de busca)

  qrToken    String     @unique // token OPACO que vai no QR — nunca o RM/PII
  photoUrl   String? // opcional (LGPD) — só para confirmação no fallback
  cardStatus CardStatus @default(ACTIVE) // bloqueio/reemissão do cartão (M2)

  // Carteira (M3). Dinheiro em centavos; saldo nunca negativo (CHECK via migration).
  balanceCents    Int  @default(0) // CHECK (balanceCents >= 0) — adicionado na migration
  dailyLimitCents Int? // nulo = sem limite diário
  version         Int  @default(0) // optimistic locking do débito (usado no M5)

  guardians    GuardianStudent[]
  transactions Transaction[]
  recharges    Recharge[]
  blocks       StudentProductBlock[] // produtos bloqueados para este aluno (o "X")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, rm]) // RM único dentro da escola
}

// Vínculo N:N responsável ↔ aluno. Regra 1–2 responsáveis por aluno é validada
// na aplicação (o SQL não expressa "no mínimo 1 / no máximo 2" bem).
model GuardianStudent {
  id         String  @id @default(cuid())
  guardianId String
  guardian   User    @relation(fields: [guardianId], references: [id])
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])

  @@unique([guardianId, studentId])
}

// Livro-caixa append-only: cada mudança de saldo (recarga agora; compra no M5).
// NUNCA UPDATE/DELETE numa linha existente — correção é uma nova linha.
model Transaction {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  type              TxType
  amountCents       Int // magnitude do movimento
  balanceAfterCents Int // saldo após o movimento (snapshot)
  createdAt         DateTime @default(now())

  @@index([studentId, createdAt]) // extrato e gastoHoje
}

// Ciclo da recarga PIX (via porta PaymentGateway). O crédito no saldo só acontece
// no CONFIRMED (webhook), idempotente pelo gatewayChargeId único.
model Recharge {
  id              String         @id @default(cuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id])
  guardianId      String
  guardian        User           @relation(fields: [guardianId], references: [id])
  amountCents     Int // vai pra cantina (via split do provedor)
  feeCents        Int // sua taxa (199)
  gatewayChargeId String?        @unique // id da cobrança no provedor; ancora a idempotência
  status          RechargeStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  confirmedAt     DateTime?

  @@index([studentId, createdAt])
}

// Item do catálogo da cantina (M4). Preço em centavos. Sem estoque com quantidade.
model Product {
  id         String  @id @default(cuid())
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  name       String
  priceCents Int
  available  Boolean @default(true) // toggle do operador (acabou → some do PDV). NÃO é estoque.
  active     Boolean @default(true) // existe no catálogo (soft-delete)

  blocks StudentProductBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// Bloqueio de um produto para um aluno (o "X"). Criado pelo responsável (ou admin).
// Cobre também alergia (bloqueia o item do alérgeno).
model StudentProductBlock {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, productId])
}
